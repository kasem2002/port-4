# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Origin allowed to call the API with credentials (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
# SQLite for local development. Point at MySQL/Postgres in production and
# change the `provider` in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Seeded on first `npm run prisma:seed`. Change the password immediately.
SEED_ADMIN_EMAIL=admin@port-4.dev
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME=PORT-4 Admin

# ── Uploads ───────────────────────────────────────────────────────────────
# Max upload size in megabytes.
MAX_UPLOAD_MB=16
